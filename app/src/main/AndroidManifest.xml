<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".entrypoint.AppCrudUsersApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCrudUsers">

        <activity
            android:name=".entrypoint.ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".entrypoint.ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".entrypoint.ui.WelcomeActivity"
            android:exported="false" />

        <activity
            android:name=".entrypoint.ui.UserListActivity"
            android:exported="false" />

        <activity
            android:name=".entrypoint.ui.UserDetailActivity"
            android:exported="false" />

        <activity
            android:name=".entrypoint.ui.CreateUserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".entrypoint.ui.UpdateUserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".entrypoint.ui.VueloListActivity"
            android:exported="false" />

        <activity
            android:name=".entrypoint.ui.VueloDetailActivity"
            android:exported="false" />

        <activity
            android:name=".entrypoint.ui.CreateVueloActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".entrypoint.ui.UpdateVueloActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>